{
  "name": "clinica-one",
  "version": "0.12.1",
  "private": true,
  "description": "Plataforma SaaS multiempresa de gestão clínica (reconstrução — Fase 1 em andamento)",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p web",
    "db:setup": "bash scripts/dev-db-setup.sh",
    "db:migrate": "tsx scripts/migrate.ts",
    "test": "vitest run",
    "check": "npm run typecheck && npm test",
    "build:web": "vite build",
    "build": "tsc --noEmit && tsc --noEmit -p web && vite build",
    "start": "node --import tsx src/server/main.ts",
    "dev:server": "tsx watch src/server/main.ts",
    "dev:web": "vite",
    "seed": "tsx scripts/seed-demo.ts",
    "totp": "tsx scripts/totp.ts",
    "rotate-key": "tsx scripts/rotate-key.ts",
    "e2e": "tsx scripts/e2e-smoke.ts",
    "setup:dev": "npm run db:setup && npm run db:migrate && npm run seed && npm run build",
    "drill": "bash scripts/backup-restore-drill.sh",
    "worker": "node --import tsx src/worker/main.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/static": "^10.1.5",
    "fastify": "^5.12.5",
    "pg": "^8.13.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "playwright-core": "^1.63.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^7.3.7",
    "vitest": "^5.0.3"
  }
}
