# Somente desenvolvimento local. Nunca commitar valores reais.
# Papéis de banco (ver ADR-0002): owner (migrations), app (runtime, sem BYPASSRLS), platform (control plane).
DATABASE_URL_OWNER=postgres://clinica_owner:dev_owner_pw@127.0.0.1:5432/clinica_one
DATABASE_URL_APP=postgres://clinica_app:dev_app_pw@127.0.0.1:5432/clinica_one
DATABASE_URL_PLATFORM=postgres://clinica_platform:dev_platform_pw@127.0.0.1:5432/clinica_one
DATABASE_URL_WORKER=postgres://clinica_worker:dev_worker_pw@127.0.0.1:5432/clinica_one
# Chave de cifragem de segredos (32 bytes em base64). Em produção: openssl rand -base64 32
# DATA_ENCRYPTION_KEY=

# Integrações (todas opcionais; sem credenciais o envio fica em sandbox). Detalhes em docs/AMBIENTE.md
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_APP_SECRET=
# WHATSAPP_VERIFY_TOKEN=
# EMAIL_API_URL=
# EMAIL_API_KEY=
# EMAIL_FROM=
# SMS_API_URL=
# SMS_API_KEY=
# SMS_FROM=
# WEBHOOK_SECRET_GENERIC=
# WORKER_INLINE=0   # em produção, rode `npm run worker` como processo separado
# BILLING_AUTO=1    # gera faturas do mês e suspende/reativa por inadimplência automaticamente (padrão: manual)

# Alertas de erro por Telegram (docs/ALERTAS.md). Sem estas duas, em desenvolvimento os avisos ficam só na memória.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_IDS=          # ids separados por vírgula (seu chat e/ou um grupo)
# ALERTS_ENV_LABEL=produção
