{
  "name": "clinica-one",
  "version": "0.2.0",
  "private": true,
  "description": "Plataforma SaaS multiempresa de gestão clínica (reconstrução — Fase 1 em andamento)",
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "db:setup": "bash scripts/dev-db-setup.sh",
